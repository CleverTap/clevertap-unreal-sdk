<?xml version="1.0" encoding="utf-8"?>
<root xmlns:android="http://schemas.android.com/apk/res/android">
	<init>
		<setBoolFromProperty result="CTAutoInit" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bAutoInitializeSharedInstance" default="false" />
		<setStringFromProperty result="CTProjectId" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="ProjectId" default="" />
		<setStringFromProperty result="CTProjectToken" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="ProjectToken" default="" />
		<setStringFromProperty result="CTRegionCode" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="RegionCode" default="" />
		<setStringFromProperty result="CTIdentityKeys" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="IdentityKeys" default="Identity,Email,Phone" />
		<setStringFromProperty result="CTEncryptionLevel" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="EncryptionLevel" default="None" />
		<setBoolFromProperty result="CTUseCustomId" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bUseCustomCleverTapId" default="false" />
		<setBoolFromProperty result="CTRequestInternetPermissions" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bRequestInternetPermissions" default="true" />
		<setBoolFromProperty result="CTRequestGeoFencePermissions" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bRequestGeoFencePermissions" default="false" />
		<setBoolFromProperty result="CTEnableBackgroundSync" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bAndroidEnablePullNotifications" default="true" />

		<setBoolFromProperty result="CTIntegrateFirebase" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bAndroidIntegrateFirebase" default="true" />
		<setBoolFromProperty result="CTIntegrateOpenUrlActivity" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="bAndroidIntegrateOpenUrlActivity" default="true" />

		<setStringFromProperty result="CTAndroidGoogleServicesJsonPath" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidGoogleServicesJsonPath" default="Config/google-services.json" />
		<setStringFromProperty result="CTDefaultNotificationChannel" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidDefaultNotificationChannel" default="" />
		<setStringFromProperty result="CTNotificationChannelSlot1" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidNotificationChannelSlot1" default='ID="default"| Name="General"| Description="General Notifications"| Importance=IMPORTANCE_DEFAULT| bShowBadge=True|' />

		<setStringFromProperty result="CTAndroidImagesDir" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidImagesDir" default="" />
		<setStringFromProperty result="CTAndroidSoundsDir" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidSoundsDir" default="" />

		<setStringFromProperty result="CTSmallNotificationIconPath" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidSmallNotificationIconPath" default="" />

		<setStringFromProperty result="CTSuspendInAppForActivities" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidSuspendInAppForActivities" default="com.epicgames.ue4.SplashActivity" />


		<setBoolIsEqual result="HaveNoSmallNotificationIcon" arg1="$S(CTSmallNotificationIconPath)" arg2="" />
		<if condition="HaveNoSmallNotificationIcon">
			<false>
				<!-- We need to strip the path to get the base filename; Start with the full path -->
				<setString result="RemainingPath" value="$S(CTSmallNotificationIconPath)" />

				<!-- Check for any slashes -->
				<setBoolContains result="HasSlash" source="$S(RemainingPath)" find="/" />

				<!-- While we still find a slash, strip up to and including it -->
				<while condition="HasSlash">
					<setIntFindString result="SlashIndex" source="$S(RemainingPath)" find="/" />
					<setIntAdd result="StartIndex" arg1="$I(SlashIndex)" arg2="1" />
					<setIntLength result="CurrentLength" source="$S(RemainingPath)" />
					<setIntSubtract result="LengthToGrab" arg1="$I(CurrentLength)" arg2="$I(SlashIndex)" />
					<setStringSubstring result="RemainingPath" source="$S(RemainingPath)" start="$I(StartIndex)" length="$I(LengthToGrab)" />
					<setBoolContains result="HasSlash" source="$S(RemainingPath)" find="/" />
				</while>

				<!-- Now we've got the just the filename & extension -->
				<setString result="SmallIconFilename" value="$S(RemainingPath)" />
			</false>
		</if>

	</init>

	<prebuildCopies>
		<copyDir src="$S(PluginDir)/Private/Android/Java/src" dst="$S(BuildDir)/src/" />

		<if condition="CTIntegrateFirebase">
			<true>
				<log text="CleverTap: including google-services.json from ini setting: $S(CTAndroidGoogleServicesJsonPath)" />
				<copyFile src="$S(PluginDir)/../../../../$S(CTAndroidGoogleServicesJsonPath)"
					dst="$S(BuildDir)/gradle/app/google-services.json" />
			</true>
			<false>
				<log text="CleverTap: NOT including google-services.json or integrating firebase" />
			</false>
		</if>

		<if condition="HaveNoSmallNotificationIcon">
			<false>
				<copyFile src="$S(PluginDir)/../../../../$S(CTSmallNotificationIconPath)"
					dst="$S(BuildDir)/res/drawable/$S(SmallIconFilename)" />
			</false>
		</if>

		<setBoolIsEqual result="HaveNoAndroidImagesDir" arg1="$S(CTAndroidImagesDir)" arg2="" />
		<if condition="HaveNoAndroidImagesDir">
			<false>
				<copyDir src="$S(PluginDir)/../../../../$S(CTAndroidImagesDir)"
					dst="$S(BuildDir)/res/drawable/" />
			</false>
		</if>

		<setBoolIsEqual result="HaveNoAndroidSoundsDir" arg1="$S(CTAndroidSoundsDir)" arg2="" />
		<if condition="HaveNoAndroidSoundsDir">
			<false>
				<copyDir src="$S(PluginDir)/../../../../$S(CTAndroidSoundsDir)"
					dst="$S(BuildDir)/res/raw/" />
			</false>
		</if>
	</prebuildCopies>

	<androidManifestUpdates>
		<if condition="CTAutoInit">
			<true>
				<setElement result="CLEVERTAP_ACCOUNT_ID" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_ACCOUNT_ID" name="android:name" value="CLEVERTAP_ACCOUNT_ID" />
				<addAttribute tag="$CLEVERTAP_ACCOUNT_ID" name="android:value" value="$S(CTProjectId)" />
				<addElement tag="application" name="CLEVERTAP_ACCOUNT_ID" />

				<setElement result="CLEVERTAP_TOKEN" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_TOKEN" name="android:name" value="CLEVERTAP_TOKEN" />
				<addAttribute tag="$CLEVERTAP_TOKEN" name="android:value" value="$S(CTProjectToken)" />
				<addElement tag="application" name="CLEVERTAP_TOKEN" />

				<setElement result="CLEVERTAP_REGION" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_REGION" name="android:name" value="CLEVERTAP_REGION" />
				<addAttribute tag="$CLEVERTAP_REGION" name="android:value" value="$S(CTRegionCode)" />
				<addElement tag="application" name="CLEVERTAP_REGION" />

				<setElement result="CLEVERTAP_IDENTIFIER" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_IDENTIFIER" name="android:name" value="CLEVERTAP_IDENTIFIER" />
				<addAttribute tag="$CLEVERTAP_IDENTIFIER" name="android:value" value="$S(CTIdentityKeys)" />
				<addElement tag="application" name="CLEVERTAP_IDENTIFIER" />

				<setBoolIsEqual result="EncryptionLevelIsEmpty" arg1="$S(CTEncryptionLevel)" arg2="" />
				<if condition="EncryptionLevelIsEmpty">
					<false>
						<setBool result="EncryptionValusIsKnown" value="false" />
						<setBoolIsEqual result="EncryptionLevelIsNone" arg1="$S(CTEncryptionLevel)" arg2="None" />
						<if condition="EncryptionLevelIsNone">
							<true>
								<setString result="EncryptionLevelValue" value="0" />
								<setBool result="EncryptionValusIsKnown" value="true" />
							</true>
						</if>
						<setBoolIsEqual result="EncryptionLevelIsMedium" arg1="$S(CTEncryptionLevel)" arg2="Medium" />
						<if condition="EncryptionLevelIsMedium">
							<true>
								<setString result="EncryptionLevelValue" value="1" />
								<setBool result="EncryptionValusIsKnown" value="true" />
							</true>
						</if>

						<if condition="EncryptionValusIsKnown">
							<true>
								<setElement result="CLEVERTAP_ENCRYPTION_LEVEL" xml="&lt;meta-data/&gt;" />
								<addAttribute tag="$CLEVERTAP_ENCRYPTION_LEVEL" name="android:name" value="CLEVERTAP_ENCRYPTION_LEVEL" />
								<addAttribute tag="$CLEVERTAP_ENCRYPTION_LEVEL" name="android:value" value="$S(EncryptionLevelValue)" />
								<addElement tag="application" name="CLEVERTAP_ENCRYPTION_LEVEL" />
							</true>
							<false>
								<log text="Error: Unknown Encryption level $S(CTEncryptionLevel)!" />
							</false>
						</if>
					</false>
				</if>

				<if condition="CTEnableBackgroundSync">
					<true>
						<setElement result="CLEVERTAP_BACKGROUND_SYNC" xml="&lt;meta-data/&gt;" />
						<addAttribute tag="$CLEVERTAP_BACKGROUND_SYNC" name="android:name" value="CLEVERTAP_BACKGROUND_SYNC" />
						<addAttribute tag="$CLEVERTAP_BACKGROUND_SYNC" name="android:value" value="1" />
						<addElement tag="application" name="CLEVERTAP_BACKGROUND_SYNC" />
					</true>
				</if>
			</true>
		</if>

		<if condition="CTUseCustomId">
			<true>
				<setElement result="CLEVERTAP_USE_CUSTOM_ID" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_USE_CUSTOM_ID" name="android:name" value="CLEVERTAP_USE_CUSTOM_ID" />
				<addAttribute tag="$CLEVERTAP_USE_CUSTOM_ID" name="android:value" value="1" />
				<addElement tag="application" name="CLEVERTAP_USE_CUSTOM_ID" />
			</true>
		</if>

		<if condition="CTRequestInternetPermissions">
			<true>
				<addPermission android:name="android.permission.INTERNET" />
				<addPermission android:name="android.permission.ACCESS_NETWORK_STATE" />
			</true>
		</if>
		<if condition="CTRequestGeoFencePermissions">
			<true>
				<addPermission android:name="android.permission.ACCESS_FINE_LOCATION" />
				<addPermission android:name="android.permission.ACCESS_COARSE_LOCATION" />
				<addPermission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
				<addPermission android:name="android.permission.WAKE_LOCK" />
				<addPermission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
			</true>
		</if>

		<if condition="CTIntegrateFirebase">
			<true>
				<addElements tag="application">
					<service
						android:name="com.clevertap.android.sdk.pushnotification.fcm.FcmMessageListenerService"
						android:exported="true">
						<intent-filter>
							<action android:name="com.google.firebase.MESSAGING_EVENT" />
						</intent-filter>
					</service>
				</addElements>
			</true>
		</if>

		<setBoolIsEqual result="HaveNoDefaultChannel" arg1="$S(CTDefaultNotificationChannel)" arg2="" />
		<if condition="HaveNoDefaultChannel">
			<false>
				<!-- strip quotes so we'll accept quoted or unquoted in the ini -->
				<setStringReplace result="UnquotedChannel" source="$S(CTDefaultNotificationChannel)" find='"' with="" />

				<setElement result="CLEVERTAP_DEFAULT_CHANNEL_ID" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_DEFAULT_CHANNEL_ID" name="android:name" value="CLEVERTAP_DEFAULT_CHANNEL_ID" />
				<addAttribute tag="$CLEVERTAP_DEFAULT_CHANNEL_ID" name="android:value" value="$S(UnquotedChannel)" />
				<addElement tag="application" name="CLEVERTAP_DEFAULT_CHANNEL_ID" />
			</false>
		</if>

		<if condition="HaveNoSmallNotificationIcon">
			<false>
				<!-- remove the extension; the metadata only wants the base name -->
				<setStringReplace result="SmallIconBaseName" source="$S(SmallIconFilename)" find=".png" with="" />

				<setElement result="CLEVERTAP_NOTIFICATION_ICON" xml="&lt;meta-data/&gt;" />
				<addAttribute tag="$CLEVERTAP_NOTIFICATION_ICON" name="android:name" value="CLEVERTAP_NOTIFICATION_ICON" />
				<addAttribute tag="$CLEVERTAP_NOTIFICATION_ICON" name="android:value" value="$S(SmallIconBaseName)" />
				<addElement tag="application" name="CLEVERTAP_NOTIFICATION_ICON" />
			</false>
		</if>

		<!-- OpenUrlActivity - Intent Filters for deep link handling

		This block adds an OpenUrlActivity <activity> with <intent-filter>s 
		using up to 4 slots defined in DefaultEngine.ini.

			AndroidIntentFilterSlotN_Scheme=string
			AndroidIntentFilterSlotN_Host=string
			AndroidIntentFilterSlotN_PathPrefix=string
			AndroidIntentFilterSlotN_AutoVerify=bool

		The <intent-filter> is required to launch the app in response to matching URLs.

		See https://developer.android.com/training/basics/intents/filters

		-->
		<if condition="CTIntegrateOpenUrlActivity">
			<true>
				<setElement result="OpenUrlActivity" value="activity" />
				<addAttribute tag="$OpenUrlActivity" name="android:name" value="com.clevertap.android.unreal.OpenUrlActivity" />
				<addAttribute tag="$OpenUrlActivity" name="android:label" value="@string/app_name" />
				<addAttribute tag="$OpenUrlActivity" name="android:exported" value="true" />
				<addAttribute tag="$OpenUrlActivity" name="android:launchMode" value="singleTop" />
				<addAttribute tag="$OpenUrlActivity" name="android:noHistory" value="true" />
				<addAttribute tag="$OpenUrlActivity" name="android:theme" value="@style/UE4SplashTheme" />

				<setInt result="index" value="1" />
				<setBool result="loopRun" value="true" />
				<while condition="loopRun">
					<setStringFromProperty result="Slot_$I(index)_Scheme" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidIntentFilterSlot$I(index)_Scheme" default="" />
					<setBoolIsEqual result="Slot_$I(index)_Scheme_IsEmpty" arg1="$S(Slot_$I(index)_Scheme)" arg2="" />
					<if condition="Slot_$I(index)_Scheme_IsEmpty">
						<false>
							<setElement result="IntentFilter_$I(index)" value="intent-filter" />
							<addElements tag="$IntentFilter_$I(index)">
								<action android:name="android.intent.action.VIEW" />
								<category android:name="android.intent.category.DEFAULT" />
								<category android:name="android.intent.category.BROWSABLE" />
							</addElements>
							<setElement result="FilterData_$I(index)" value="data" />
							<addAttribute tag="$FilterData_$I(index)" name="android:scheme" value="$S(Slot_$I(index)_Scheme)" />

							<setStringFromProperty result="Slot_$I(index)_Host" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidIntentFilterSlot$I(index)_Host" default="" />
							<setBoolIsEqual result="Slot_$I(index)_Host_IsEmpty" arg1="$S(Slot_$I(index)_Host)" arg2="" />
							<if condition="Slot_$I(index)_Host_IsEmpty">
								<false>
									<addAttribute tag="$FilterData_$I(index)" name="android:host" value="$S(Slot_$I(index)_Host)" />
								</false>
							</if>

							<setStringFromProperty result="Slot_$I(index)_PathPrefix" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidIntentFilterSlot$I(index)_PathPrefix" default="" />
							<setBoolIsEqual result="Slot_$I(index)_PathPrefix_IsEmpty" arg1="$S(Slot_$I(index)_PathPrefix)" arg2="" />
							<if condition="Slot_$I(index)_Host_IsEmpty">
								<false>
									<addAttribute tag="$FilterData_$I(index)" name="android:pathPrefix" value="$S(Slot_$I(index)_PathPrefix)" />
								</false>
							</if>

							<setBoolFromProperty result="Slot_$I(index)_AutoVerify" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidIntentFilterSlot$I(index)_AutoVerify" default="false" />
							<if condition="Slot_$I(index)_AutoVerify">
								<true>
									<addAttribute tag="$IntentFilter_$I(index)" name="android:autoVerify" value="true" />
								</true>
							</if>

							<addElement tag="$IntentFilter_$I(index)" name="FilterData_$I(index)" />
							<addElement tag="$OpenUrlActivity" name="IntentFilter_$I(index)" />
						</false>
					</if>
					<setIntAdd result="index" arg1="$I(index)" arg2="1" />
					<setBoolIsLessEqual result="loopRun" arg1="$I(index)" arg2="4" />
				</while>
				<addElement tag="application" name="OpenUrlActivity" />
			</true>
		</if>

		<setBoolIsEqual result="InAppExcludeIsEmpty" arg1="$S(CTSuspendInAppForActivities)" arg2="" />
		<if condition="InAppExcludeIsEmpty">
			<false>
				<setElement result="CLEVERTAP_INAPP_EXCLUDE" value="meta-data" />
				<addAttribute tag="$CLEVERTAP_INAPP_EXCLUDE" name="android:name" value="CLEVERTAP_INAPP_EXCLUDE" />
				<addAttribute tag="$CLEVERTAP_INAPP_EXCLUDE" name="android:value" value="$S(CTSuspendInAppForActivities)" />
				<addElement tag="application" name="CLEVERTAP_INAPP_EXCLUDE" />
			</false>
		</if>
	</androidManifestUpdates>


	<buildscriptGradleAdditions>
		<if condition="CTIntegrateFirebase">
			<true>
				<insert>
					dependencies { classpath "com.google.gms:google-services:4.4.2" }
				</insert>
			</true>
		</if>
	</buildscriptGradleAdditions>

	<buildGradleAdditions>
		<insert>
			dependencies {
			// checkout the latest sdk version at
			// https://github.com/CleverTap/clevertap-android-sdk/blob/master/README.md#-installation
			implementation "com.clevertap.android:clevertap-android-sdk:7.3.1"
			implementation "com.clevertap.android:push-templates:1.4.0"
			implementation "androidx.core:core:1.13.0"
			implementation 'com.android.installreferrer:installreferrer:2.2'

			// implementation "com.google.android.gms:play-services-ads:23.6.0" // Required only if you enable Google ADID collection in the SDK (turned off by default).
			}
		</insert>

		<if condition="CTIntegrateFirebase">
			<true>
				<insert>
					dependencies { implementation "com.google.firebase:firebase-messaging:24.0.0" }
					apply plugin: 'com.google.gms.google-services'
				</insert>
			</true>
		</if>
	</buildGradleAdditions>

	<gameApplicationAttachBaseContextAdditions>
		<insert>
			com.clevertap.android.sdk.ActivityLifecycleCallback.register(this);
		</insert>
	</gameApplicationAttachBaseContextAdditions>

	<gameApplicationOnCreateAdditions>
		<if condition="CTAutoInit">
			<true>
				<insert>
					com.clevertap.android.sdk.CleverTapAPI CleverTapAPI = com.clevertap.android.sdk.CleverTapAPI.getDefaultInstance(getApplicationContext());
					CleverTapAPI.suspendInAppNotifications();
					CleverTapAPI.setNotificationHandler((com.clevertap.android.sdk.interfaces.NotificationHandler)new com.clevertap.android.pushtemplates.PushTemplateNotificationHandler());
				</insert>
			</true>
		</if>

		<!-- Notification Channel Group Configuration
		
			This section generates a call to CleverTapAPI.createNotificationChannelGroup() for each non-empty AndroidNotificationChannelGroupSlot defined in the ini file.

			Expected input looks like this; each field is optional in the grammar, but the ID field is required for it to work at runtime:
				AndroidNotificationChannelSlot1=ID="general" | Name="General"

			We pre-declare variables and constants to create a suitable context, then replace all pipes (|) with semicolons (;) to form valid Java assignment syntax.
			(Pipes were used instead of semicolons because Unreal's various INI parsers handle semicolons inconsistently.)
				ID="general" ; Name="General" 

			Then for each slot we:
				- restore all variables to their defaults
				- apply the settings using the java we got from search and replace
				- call CleverTapAPI.createNotificationChannelGroup() using the settings variables

		-->
		<insert>
			{
			String ID;
			String Name;
		</insert>

		<setString result="SetNotificationChannelGroupDefaults" value='ID=""; Name=""; ' />
		<setString result="CreateNotificationChannelGroup" value='com.clevertap.android.sdk.CleverTapAPI.createNotificationChannelGroup( getApplicationContext(), ID, Name.isEmpty() ? ID : Name );' />

		<setInt result="index" value="1" />
		<setBool result="loopRun" value="true" />
		<while condition="loopRun">
			<setStringFromProperty result="CTNotificationChannelGroupSlot$I(index)" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidNotificationChannelGroupSlot$I(index)" default="" />
			<setBoolIsEqual result="GroupSlot_$I(index)_IsEmpty" arg1="$S(CTNotificationChannelGroupSlot$I(index))" arg2="" />
			<if condition="GroupSlot_$I(index)_IsEmpty">
				<false>
					<insertValue value="$S(SetNotificationChannelGroupDefaults)" />
					<insertNewline />
					<setStringReplace result="ConfigureGroupSlot$I(index)" source="$S(CTNotificationChannelGroupSlot$I(index))" find="|" with=";" />
					<insertValue value="$S(ConfigureGroupSlot$I(index));" />
					<insertNewline />
					<insertValue value="$S(CreateNotificationChannelGroup)" />
					<insertNewline />
				</false>
			</if>
			<setIntAdd result="index" arg1="$I(index)" arg2="1" />
			<setBoolIsLessEqual result="loopRun" arg1="$I(index)" arg2="10" />
		</while>

		<insert>
			}
		</insert>

		<!-- Notification Channel Configuration
		
			This section generates a call to CleverTapAPI.createNotificationChannel() for each non-empty AndroidNotificationChannelSlot defined in the ini file.

			Expected input looks like this; each field is optional in the grammar, but the ID field is required for it to work at runtime:
				AndroidNotificationChannelSlot1=ID="general" | Group="general" | Name="General" | Description="General Notifications" | Importance=IMPORTANCE_DEFAULT | bShowBadge=True

			We pre-declare variables and constants to create a suitable context, then replace all pipes (|) with semicolons (;) to form valid Java assignment syntax.
			(Pipes were used instead of semicolons because Unreal's various INI parsers handle semicolons inconsistently.)
				ID="general" ; Group="general" ; Name="General" ; Description="General Notifications" ; Importance=IMPORTANCE_DEFAULT ; bShowBadge=True

			Then for each slot we:
				- restore all variables to their defaults
				- apply the settings using the java we got from search and replace
				- call CleverTapAPI.createNotificationChannel() using the settings variables

		-->
		<insert>
			{
			final int IMPORTANCE_DEFAULT = android.app.NotificationManager.IMPORTANCE_DEFAULT;
			final int IMPORTANCE_HIGH = android.app.NotificationManager.IMPORTANCE_HIGH;
			final int IMPORTANCE_LOW = android.app.NotificationManager.IMPORTANCE_LOW;
			final int IMPORTANCE_MAX = android.app.NotificationManager.IMPORTANCE_MAX;
			final int IMPORTANCE_MIN = android.app.NotificationManager.IMPORTANCE_MIN;
			final int IMPORTANCE_NONE = android.app.NotificationManager.IMPORTANCE_NONE;
			final boolean False = false;
			final boolean True = true;
			String ID;
			String Group;
			String Name;
			String Description;
			int Importance = IMPORTANCE_DEFAULT;
			boolean bShowBadge = true;
			String Sound;
		</insert>

		<setString result="SetNotificationChannelDefaults" value='ID=""; Group=""; Name=""; Description=""; Importance=IMPORTANCE_DEFAULT; bShowBadge=True; Sound="";' />
		<setString result="CreateNotificationChannel" value='com.clevertap.android.unreal.UECleverTapBridge.createNotificationChannel( getApplicationContext(), ID, Name, Description, Importance, Group, bShowBadge, Sound);' />

		<setInt result="index" value="1" />
		<setBool result="loopRun" value="true" />
		<while condition="loopRun">
			<setBoolIsEqual result="Slot_$I(index)_IsEmpty" arg1="$S(CTNotificationChannelSlot$I(index))" arg2="" />
			<if condition="Slot_$I(index)_IsEmpty">
				<false>
					<insertValue value="$S(SetNotificationChannelDefaults)" />
					<setStringReplace result="ConfigureSlot$I(index)" source="$S(CTNotificationChannelSlot$I(index))" find="|" with=";" />
					<insertNewline />
					<insertValue value="$S(ConfigureSlot$I(index));" />
					<insertNewline />
					<insertValue value="$S(CreateNotificationChannel)" />
					<insertNewline />
				</false>
			</if>
			<setIntAdd result="index" arg1="$I(index)" arg2="1" />
			<setBoolIsLessEqual result="loopRun" arg1="$I(index)" arg2="100" />

			<!-- load the string for the next iteration; this makes it easy for the first slot to have a different default -->
			<setStringFromProperty result="CTNotificationChannelSlot$I(index)" ini="Engine" section="/Script/CleverTap.CleverTapConfig" property="AndroidNotificationChannelSlot$I(index)" default="" />
		</while>

		<insert>
			}
		</insert>
	</gameApplicationOnCreateAdditions>

	<!-- intent handling -->
	<gameActivityOnCreateAdditions>
